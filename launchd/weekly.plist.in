<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>__PREFIX__.weekly</string>
  <key>ProgramArguments</key><array><string>/usr/bin/python3</string><string>__ZEKE_HOME__/engine.py</string><string>scan</string><string>--notify</string><string>--trigger</string><string>weekly</string></array>
  <key>EnvironmentVariables</key><dict><key>PATH</key><string>__PATH__</string><key>ZEKE_HOME</key><string>__ZEKE_HOME__</string></dict>
  <key>StartCalendarInterval</key><dict><key>Weekday</key><integer>0</integer><key>Hour</key><integer>10</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>__ZEKE_HOME__/logs/weekly.log</string>
  <key>StandardErrorPath</key><string>__ZEKE_HOME__/logs/weekly.log</string>
</dict></plist>
